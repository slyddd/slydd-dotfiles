// ╔═╗┬ ┬ ┬┌┬┐┌┬┐  ┌┬┐┌─┐┌┬┐┌─┐
// ╚═╗│ └┬┘ ││ ││───│││ │ │ └─┐
// ╚═╝┴─┘┴ ─┴┘─┴┘  ─┴┘└─┘ ┴ └─┘
// Rofi Default Theme

@import "colors.rasi"
* {
  spacing: 8px;
  background-color: transparent;
  text-color: @on-background;
}

window {
  width: 500px;
  border: 0px;
  border-radius: 15px;
  padding: 20px;
  background-color: @background;
}

inputbar {
  children: [ entry ];
  border-radius: 0px;
  border: 0px;
  padding: 12px;
}

listview {
  columns: 1;
  lines: 8;
  spacing: 8px;
  scrollbar: false;
}

element {
  orientation: horizontal;
  border-radius: 10px;
  padding: 10px;
  spacing: 12px;
}

element selected {
  background-color: @primary;
  border-radius: 10px;
}
element-text selected {
  background-color: transparent;
  text-color: @on-primary;
}

element-icon {
  size: 24px;
  background-color: transparent;
}

element-text {
  vertical-align: 0.5;
}
