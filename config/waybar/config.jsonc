[
  {
    "include": [
      "./modules/os/os.jsonc",
      "./modules/hyprland/workspaces.jsonc",
      "./modules/hyprland/window.jsonc",
      "./modules/hyprland/submap.jsonc",
      "./modules/clock.jsonc",
      "./modules/caffeine/caffeine.jsonc",
      "./modules/privacy/privacy.jsonc",
      "./modules/power.jsonc",
    ],
    "position": "top",
    "layer": "top",
    "modules-left": ["group/os", "hyprland/window"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": [
      "custom/privacydots",
      "clock",
      "custom/power",
      "group/caffeine",
      "hyprland/submap",
    ],
    "spacing": 10,
    "reload_style_on_change": true,
  },
  {
    "include": [
      "./modules/multimedia/multimedia.jsonc",
      "./modules/control-center.jsonc",
      "./modules/network/network.jsonc",
      "./modules/bluetooth/bluetooth.jsonc",
      "./modules/audio/audio.jsonc",
      "./modules/battery/battery.jsonc",
      "./modules/tray/tray.jsonc",
      "./modules/wallpaper.jsonc",
      "./modules/ai/ai-usage.jsonc",
      "./modules/kdeconnect/kdeconnect.jsonc",
      "./modules/tailscale/tailscale.jsonc",
    ],
    "width": 1900,
    "margin": 5,
    "spacing": 10,
    "position": "bottom",
    "output": "eDP-1",
    "layer": "top",
    "modules-left": ["group/multimedia"],
    "modules-center": ["group/control-center"],
    "modules-right": [
      "custom/wallpaper",
      "group/ai",
      "custom/kdeconnect",
      "custom/tailscale",
    ],
  },
]
