[
  {
    "include": [
      "./modules/os/os.jsonc",
      "./modules/niri/workspaces.jsonc",
      "./modules/niri/window.jsonc",
      "./modules/clock/clock.jsonc",
      "./modules/privacy/privacy.jsonc",
      "./modules/power/power.jsonc",
    ],
    "position": "top",
    "layer": "top",
    "modules-left": ["group/os", "niri/window"],
    "modules-center": ["niri/workspaces"],
    "modules-right": ["custom/privacydots", "clock", "custom/power"],
    "spacing": 10,
    "reload_style_on_change": true,
  },

  {
    "include": [
      "./modules/multimedia/multimedia.jsonc",
      "./modules/control-center/control-center.jsonc",
      "./modules/tool-center/tool-center.jsonc",
      "./modules/network/network.jsonc",
      "./modules/bluetooth/bluetooth.jsonc",
      "./modules/audio/audio.jsonc",
      "./modules/battery/battery.jsonc",
      "./modules/tray/tray.jsonc",
      "./modules/wallpaper/wallpaper.jsonc",
      "./modules/ai/ai-usage.jsonc",
      "./modules/kdeconnect/kdeconnect.jsonc",
      "./modules/tailscale/tailscale.jsonc",
    ],
    "spacing": 10,
    "position": "bottom",
    "layer": "top",
    "modules-left": ["group/multimedia"],
    "modules-center": ["group/control-center"],
    "modules-right": ["group/tool-center"],
  },
  {
    "position": "left",
    "layer": "top",
    "passthrough": true,
    "width": 10,
  },
  {
    "position": "right",
    "layer": "top",
    "passthrough": true,
    "width": 10,
  },
  // Rounded box
  {
    "position": "top",
    "layer": "top",
    "name": "radius",
    "exclusive": false,
    "passthrough": true,
    "height": 15,
  },
  {
    "position": "bottom",
    "layer": "top",
    "name": "radius",
    "exclusive": false,
    "passthrough": true,
    "height": 15,
  },
]
