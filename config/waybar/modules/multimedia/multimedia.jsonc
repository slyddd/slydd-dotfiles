{
  "group/multimedia": {
    "orientation": "horizontal",
    "modules": ["mpris", "custom/lyrics"],
  },

  // Modules
  "mpris": {
    "format": "{status_icon} {artist} - {title}",
    "tooltip-format": "{title}\n{album}\n{artist}",
    "player-icons": {
      "default": "󰎆",
    },
    "status-icons": {
      "paused": "󰏤 ",
      "stopped": "󰓛 ",
    },
  },

  "custom/lyrics": {
    "return-type": "json",
    "format": "{}",
    "hide-empty-text": true,
    "exec": "waybar-lyric --quiet -p spotify -l",
    "on-click": "waybar-lyric play-pause",
  },
}
