{
  "group/net": {
    "orientation": "inherit",
    "modules": ["network#icon", "network#info"],
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true,
    },
  },

  "network#icon": {
    "format": "{icon}",
    "format-icons": {
      "wifi": "",
      "ethernet": "󰈀",
      "disconnected": "",
    },
    "tooltip-format": "{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "kitty -T 'Impala' -e wlctl",
  },

  "network#info": {
    "format": "{ifname}",
    "format-wifi": "{essid}",
    "format-disconnected": "",
    "tooltip-format": "{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "kitty -T 'Impala' -e wlctl",
  },
}
