{
  "custom/tailscale": {
    "exec": "$HOME/.config/waybar/modules/tailscale/tailscale.sh --status 'ipv4'",
    "on-click": "$HOME/.config/waybar/modules/tailscale/tailscale.sh --toggle",
    "on-click-right": "noctalia msg panel-toggle davemhammer/tailscale:manager",
    "exec-on-event": true,
    "format": "{icon}",
    "format-icons": {
      "connected": "󰯄",
      "stopped": "󰦞",
    },
    "tooltip": true,
    "return-type": "json",
    "interval": 1,
  },
}
