{
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "special": "",
      "active": "󰮯",
      "empty": "",
      "default": "󰊠",
    },
    "on-scroll-down": "niri msg action focus-workspace-down",
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-current-monitor": true,
    "tooltip": false,
  },
}
