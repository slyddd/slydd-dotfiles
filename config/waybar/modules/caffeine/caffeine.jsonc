{
  "group/caffeine": {
    "orientation": "inherit",
    "modules": ["idle_inhibitor#icon", "idle_inhibitor#info"],
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true,
    },
  },

  "idle_inhibitor#icon": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪",
    },
    "timeout": 0,
    "signal": 8,
  },

  "idle_inhibitor#info": {
    "format": "{icon}",
    "format-icons": {
      "activated": "ACTIVE",
      "deactivated": "INACTIVE",
    },
    "timeout": 0,
  },
}
