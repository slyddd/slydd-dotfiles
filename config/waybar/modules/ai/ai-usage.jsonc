{
  "group/ai": {
    "orientation": "inherit",
    "modules": ["custom/ai-usage", "custom/ai-left"],
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true,
    },
  },

  "custom/ai-usage": {
    "exec": "$HOME/.config/waybar/modules/ai/ai-usage.sh",
    "tooltip": true,
    "interval": 1,
    "return-type": "json",
  },

  "custom/ai-left": {
    "exec": "$HOME/.config/waybar/modules/ai/ai-usage.sh --coin",
    "return-type": "json",
    "tooltip": true,
    "interval": 1,
  },
}
