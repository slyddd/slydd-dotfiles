// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

/*
  Noctalia
  Disable xray on all our surfaces so it looks more realistic.
  Noctalia publishes blur regions automatically when ext-background-effects is available.
*/
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
  }
}

/* Enable blur on noctalia's window switcher and disable xray. */
layer-rule {
  match namespace="noctalia-window-switcher"
  background-effect {
    blur true
    xray false
  }
}
layer-rule {
  match namespace="waybar"
  background-effect {
    blur true
    xray false
  }
}

// Opacity apps
window-rule {
  match app-id="zed"
  opacity 1.0
}
window-rule {
  match app-id="zen"
  opacity 1.0
}
window-rule {
  match app-id="ferdium"
  opacity 0.96
}

// Floating apps
window-rule {
  match app-id="blueman-manager|com.saivert.pwvucontrol"
  match title="Impala|Bluetui|Wiremix"
  open-floating true
  default-column-width { fixed 800; }
  default-window-height { fixed 700; }
}
