input {
  keyboard {
    xkb {
      layout "us"
      variant "altgr-intl"
    }
  }

  touchpad {
    tap
    natural-scroll
  }
}

output "eDP-1" {
  scale 1
  position x=0 y=0
}

output "HDMI-A-1" {
  scale 1
  mode "1920x1080@120.00"
  position x=1920 y=0
}

hotkey-overlay {
  skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
  honor-xdg-activation-with-invalid-serial
  force-pipewire-invalid-modifier
}


include "secrets.kdl"
include "env.kdl"
include "noctalia.kdl"
include "autostart.kdl"
include "ui.kdl"
include "rules.kdl"

// Binds
include "binds/apps.kdl"
include "binds/monitor.kdl"
include "binds/system.kdl"
include "binds/ui.kdl"
include "binds/window.kdl"
include "binds/workspace.kdl"
