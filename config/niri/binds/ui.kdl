binds {
  Mod+L hotkey-overlay-title="Lock the Screen" { spawn-sh "noctalia msg session lock"; }
  Mod+I hotkey-overlay-title="Show settings" { spawn-sh "noctalia msg settings-toggle"; }
  Mod+O repeat=false { toggle-overview; }
  Mod+Shift+R repeat=false { spawn-sh "pkill -SIGUSR2 waybar || waybar"; }
  Mod+Escape hotkey-overlay-title="Show power menu" { spawn-sh "noctalia msg panel-toggle session"; }
  Mod+V hotkey-overlay-title="Show clipboard menu" { spawn-sh "noctalia msg panel-toggle clipboard"; }
  Mod+Period hotkey-overlay-title="Show emoji menu" { spawn-sh "noctalia msg panel-toggle launcher '/emo'"; }
  Mod+P hotkey-overlay-title="Show passwords menu" { spawn-sh "noctalia msg panel-toggle launcher '/bw'"; }
  Mod+H hotkey-overlay-title="Show home menu" { spawn-sh "noctalia msg panel-toggle pozzoo/hassio:entity_manager"; }
  Mod+G hotkey-overlay-title="Show games menu" { spawn-sh "noctalia msg panel-toggle alexander/game-launcher:browser"; }
  Mod+C hotkey-overlay-title="Show color picker" { spawn-sh "hyprpicker -a -c"; }
  Mod+D hotkey-overlay-title="Show dashboard" { spawn-sh "noctalia msg panel-toggle control-center"; }
  Mod+N hotkey-overlay-title="Show notes" { spawn-sh "noctalia msg panel-toggle fel/quill:panel"; }
}
