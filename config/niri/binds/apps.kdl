binds {
  Mod+Space hotkey-overlay-title="Open Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
  Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "kitty"; }
  Mod+E hotkey-overlay-title="Open File Manager" { spawn "nautilus"; }
  Mod+B hotkey-overlay-title="Open File Browser" { spawn "zen-browser"; }
  Mod+Shift+Escape hotkey-overlay-title="Open Task Manager" { spawn-sh "kitty -e btop"; }
}
