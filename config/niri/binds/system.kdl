binds {
  XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
  XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
  XF86AudioMicMute     allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }

  Mod+XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
  Mod+XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
  XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia msg brightness-up"; }
  XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia msg brightness-down"; }

  Print { spawn-sh "noctalia msg screenshot-region"; }
  Shift+Print { spawn-sh "noctalia msg screenshot-fullscreen"; }
  Ctrl+Print { screenshot-window; }

  Mod+Shift+S { spawn-sh "noctalia msg screenshot-region"; }
  Mod+Ctrl+Shift+S { spawn-sh "noctalia msg screenshot-fullscreen"; }
  Mod+Alt+Shift+S { screenshot-window; }
}
