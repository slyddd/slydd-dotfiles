prefer-no-csd
layout {
  gaps 15
  center-focused-column "on-overflow"
  always-center-single-column true
  default-column-width {
    proportion 0.9;
  }
  focus-ring {
    width 2
  }

  shadow {
    on
    softness 30
    spread 5
    offset x=0 y=5
    color "#0007"
  }
}
blur {
    // off
    passes 2
    offset 2
    noise 0.02
    saturation 1
}

cursor {
  xcursor-theme "Bibata-Modern-Ice"
  xcursor-size 24
  hide-when-typing
}

// Make workspaces four times smaller than normal in the overview.
overview {
  zoom 0.5
  backdrop-color "#000000"
}

recent-windows {
  debounce-ms 750
  open-delay-ms 150

  highlight {
    padding 10
    corner-radius 10
  }

  previews {
    max-height 280
    max-scale 0.4
  }
}

window-rule {
  geometry-corner-radius 12
  clip-to-geometry true
  background-effect {
    blur true
    xray false
  }
}

window-rule {
  match is-focused=false
  opacity 0.95
}
