{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "matugen",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "single": false,
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "new_location": "launch",
    "image_preview": false,
    "markdown": "rendered",
    "grouping": "auto",
    "permissions": "prompt"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true
  },
  "tabs": {
    "scope": "cwd",
    "layout": "horizontal",
    "mode": "auto",
    "indicators": "status"
  },
  "keybinds": {
    "agent.cycle": "tab",
    "prompt.autocomplete.complete": "ctrl+n"
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "terminal": {
    "copy": "select"
  }
}
