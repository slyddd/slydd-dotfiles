# ignore kitty backup files
config/kitty/*.bak

# ignore zsh completion dump files and history
.zcompdump*
zsh_history

# ignore .env
.env
secrets.kdl
.env.sh

# Noctalia-generated theme files (regenerated on every theme change)
config/waybar/colors.css
config/zed/themes/noctalia.json
config/kitty/themes/noctalia.conf
config/btop/themes/noctalia.theme
config/niri/noctalia.kdl
config/opencode/themes/matugen.json
config/nvim/lua/matugen.lua

# Calcure data files
config/calcure/*.csv
config/calcure/*.log
